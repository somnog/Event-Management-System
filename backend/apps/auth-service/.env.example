# auth-service environment template
#
# Copy to `.env` and fill in real values. Never commit the filled-in `.env`.
#   cp .env.example .env

NODE_ENV=development

# Postgres. The port must match the host port published by docker/docker-compose.yml
# (5533 -> 5432 inside the container), NOT the container's own 5432.
# The `auth` schema is created by `npx prisma migrate deploy`.
DATABASE_URL="postgresql://somnog:somnog@localhost:5533/emsdb?schema=auth"

# RabbitMQ broker. Default credentials come from the rabbitmq image.
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# The queue this service consumes. Every service MUST have its own queue --
# sharing one makes services compete for each other's messages.
AUTH_QUEUE=auth_queue

# Signing key for access and refresh tokens. MUST be identical to the gateway's
# JWT_SECRET, or the gateway cannot verify tokens this service issues.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
