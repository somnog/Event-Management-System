# gateway environment template
#
# Copy to `.env` and fill in real values. Never commit the filled-in `.env`.
#   cp .env.example .env

NODE_ENV=development

# Port the public HTTP API listens on.
PORT=3000

# Postgres. The gateway does not own business data -- this is used only by the
# /health check. The port must match the host port published by
# docker/docker-compose.yml (5533), NOT the container's own 5432.
DATABASE_URL="postgresql://somnog:somnog@localhost:5533/emsdb?schema=auth"

# RabbitMQ broker.
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# One queue per downstream service. These must match the queue each service
# consumes, and no two services may share a queue.
AUTH_QUEUE=auth_queue
EVENT_QUEUE=event_queue

# Used to VERIFY tokens issued by the auth-service, so it MUST be identical to
# that service's JWT_SECRET.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
